{
    "name": "tweakwise/magento2-tweakwise-hyva",
    "license": "OSL-3.0",
    "description": "Hyvä Themes Compatibility module for Tweakwise_Magento2Tweakwise",
    "type": "magento2-module",
    "replace": {
        "emico/tweakwise-hyva": "1.1.0"
    },
    "require": {
        "php": "^8.1",
        "hyva-themes/magento2-compat-module-fallback": "*",
        "hyva-themes/magento2-default-theme": "^1.3.15",
        "tweakwise/magento2-tweakwise": ">=8.11.0",
        "magento/framework": "*",
        "magento/module-swatches": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Tweakwise\\TweakwiseHyva\\": "src/"
        }
    },
    "repositories": {
        "emico": {
            "type": "composer",
            "url": "https://git.emico.io/api/v4/group/239/-/packages/composer/",
            "only": [
                "emico/code-quality",
                "emico/codeception-m2",
                "hipex/magento-2-psr7-bridge"
            ]
        },
        "magento": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        "hyva-themes": {
            "type": "composer",
            "url": "https://hyva-themes.repo.packagist.com/TWEAKWISE_PLACEHOLDER/",
            "only": ["hyva-themes/*"]
        }
    },
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "magento/magento-composer-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "phpro/grumphp": true,
            "emico/code-quality": true
        }
    },
    "require-dev": {
        "emico/code-quality": "^10.8"
    }
}
